# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Anthropic API key (used by the Claude models, direct — no gateway)
ANTHROPIC_API_KEY=****

# Google Generative AI API key (used by the Gemini models, direct — no gateway)
GOOGLE_GENERATIVE_AI_API_KEY=****

# OpenAI API key (used by the GPT models, direct — no gateway)
OPENAI_API_KEY=****

# Hugging Face Inference Providers token (https://huggingface.co/settings/tokens)
# Wired into lib/ai/providers.ts but NOT active by default — a model only
# shows up in the selector once you add it to chatModels in lib/ai/models.ts.
HUGGINGFACE_API_KEY=****

# BNCC API key (https://bncc.api.br) — used by the lookupBnccHabilidade tool
BNCC_API_KEY=****

# Cloudflare R2 (S3-compatible) — used to store uploaded plano images
# https://developers.cloudflare.com/r2/api/s3/tokens/
R2_ACCOUNT_ID=****
R2_ACCESS_KEY_ID=****
R2_SECRET_ACCESS_KEY=****
R2_BUCKET_NAME=****
# public r2.dev bucket URL, e.g. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****
